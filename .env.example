# Copy to .env and fill in. Never commit .env.

# ---- the app ----
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=change-me-to-a-long-random-string   # also signs the tokens the agents use to reach /mcp
DEV_LOGIN=1                       # 1 enables POST /api/auth/dev (local testing only)
ALLOWED_EMAILS=                   # comma-separated emails allowed to sign in; empty = anyone who can reach the app
# PUBLIC_WS_URL=wss://your-server.example   # only when the web app is served from another host (e.g. Vercel, see vercel.json):
#                                         # that host cannot pass WebSockets on, so the screen viewer connects here directly
# DB_PATH=./data/grokbot.db       # where the app keeps its SQLite database

# ---- the agents (Hermes) ----
HERMES_BIN=hermes                 # the hermes CLI; it starts one gateway per extra bot
HERMES_URL=http://127.0.0.1:8642  # API server of the agent that already runs (the first bot)
# HERMES_HOME_PRIMARY=~/.hermes   # that agent's home (memory files, .env with API_SERVER_KEY)
# HERMES_KEY=                     # its API key, when not readable from <home>/.env
# ENGINES_DIR=./data/engines      # homes of the extra bots; must be outside ~/.hermes
# ENGINE_PORT_BASE=8650
# MCP_BASE_URL=http://127.0.0.1:8787   # how the agents reach this server
# EXTRA_MCP_SERVERS=              # JSON object of Hermes mcp_servers entries every extra bot gets
# PRIMARY_BOT_NAME=Doug
# PRIMARY_BOT_LABEL=Chief of Staff

# ---- the one computer every bot works on (one screen per bot) ----
# COMPUTER_PROVIDER=orgo uses an Orgo cloud computer (the keys below).
# COMPUTER_PROVIDER=local runs the screens on the machine this server runs on (Xvfb + x11vnc +
# websockify), e.g. a Zo server; no Orgo key needed. Needs: xvfb x11vnc websockify xfwm4 chromium imagemagick.
COMPUTER_PROVIDER=orgo
# LOCAL_SCREENS_DIR=/root/grokbot/local-screens
# LOCAL_SCREEN_SIZE=1440x900
ORGO_API_KEY=                     # or ORGO_API_KEY_FILE=/path/to/file
ORGO_COMPUTER_ID=
HQ_LOCAL=0                        # 1 when this server runs on that computer (production)
# PRIMARY_CDP_URL=http://127.0.0.1:9333   # a Chrome the first bot already owns on the default screen
MAX_BOTS=4                        # May be higher in local mode. Orgo is capped at four screens.# MACRO_TEAM_URL=https://...        # RevOpt Admin: the Macro desktop frontend, if it serves. Embedded when set.

# ---- connectors, X research, voice ----
COMPOSIO_API_KEY=
XAI_API_KEY=                      # x_search (research on X) and the voice modes
XAI_MODEL=grok-4.7
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0

# A2UI durable agent (agents/a2ui-durable, docs/a2ui/CONTRACT.md). Two consumers read these:
#  - the Node server (server/src/a2ui-relay.ts, production): relays /a2ui/ws and /a2ui/health to the
#    agent behind Bot HQ sign-in; loads this file via --env-file.
#  - the Vite dev proxy (web/vite.config.ts, dev): proxies /a2ui/ straight to the agent; reads the
#    BOTHQ_A2UI_* lines of this file (and the shell, which wins). BOTHQ_A2UI_URL is its old name, still honoured.
# Agent base URL (both consumers):
# BOTHQ_A2UI_AGENT_URL=http://127.0.0.1:8790
# Shared secret. The agent (same env var) then requires header `x-bothq-a2ui-token` on /a2ui/ws and
# /a2ui/health, and refuses a non-loopback --listen without it; the relay and the Vite proxy send it.
# The browser never sees it.
# BOTHQ_A2UI_TOKEN=
# Relay only: the one Bot HQ workspace allowed to use the agent (a user id or email; workspace members
# are admitted too, others get 403). The agent has ONE global session, so unset means every signed-in
# user shares it (warned at startup; MVP limitation).
# BOTHQ_A2UI_OWNER=you@example.com
